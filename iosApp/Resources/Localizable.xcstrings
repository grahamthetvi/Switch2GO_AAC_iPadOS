    "Keep it simple — show fewer symbols per page (2–4 is ideal). Go to Settings → Categories Display → CVI Display Settings to set symbol count and per-position colors.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep it simple — show fewer symbols per page (2–4 is ideal). Go to Settings → Categories Display → CVI Display Settings to set symbol count and per-position colors."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Manténgalo simple: menos símbolos por página (2–4 es ideal). Vaya a Ajustes → Visualización de categorías → Ajustes de pantalla CVI."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restez simple : moins de symboles par page (2–4 idéal). Réglages → Affichage des catégories → Réglages d’affichage CVI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einfach halten — weniger Symbole pro Seite (2–4 ideal). Einstellungen → Kategorieanzeige → CVI-Anzeigeeinstellungen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حافظ على البساطة — رموز أقل في الصفحة (2–4 مثالي). الإعدادات ← عرض الفئات ← إعدادات عرض CVI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持简单——每页少放符号（2–4 最理想）。前往设置 → 类别显示 → CVI 显示设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持簡單——每頁少放符號（2–4 最理想）。前往設定 → 類別顯示 → CVI 顯示設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シンプルに。1ページの記号は少なめ（2〜4が目安）。設定 → カテゴリ表示 → CVI表示設定。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ đơn giản — ít ký hiệu mỗi trang (2–4 là lý tưởng). Vào Cài đặt → Hiển thị danh mục → Cài đặt hiển thị CVI."
          }
        }
      }
    },
