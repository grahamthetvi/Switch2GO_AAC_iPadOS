    "The tool can automatically remove the background from any image, isolating just the subject. This makes the image cleaner and easier to recognize against your phrase's background color.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tool can automatically remove the background from any image, isolating just the subject. This makes the image cleaner and easier to recognize against your phrase's background color."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La herramienta puede quitar el fondo de cualquier imagen y dejar solo el sujeto, más limpio y fácil de reconocer sobre el color de fondo de la frase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’outil peut retirer automatiquement le fond pour isoler le sujet. L’image est plus nette sur la couleur de fond de la phrase."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Tool kann den Hintergrund entfernen und nur das Motiv lassen. Das Bild ist klarer vor der Hintergrundfarbe der Phrase."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للأداة إزالة الخلفية تلقائيًا وعزل الموضوع، فيصير أوضح على لون خلفية العبارة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具可自动抠除背景，只留下主体，在语句背景色上更清晰易认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工具可自動去背，只留下主體，在語句背景色上更清晰易認。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景を自動で取り除き、被写体だけにできます。フレーズの背景色の上で見分けやすくなります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công cụ có thể tự xóa nền, chỉ giữ chủ thể. Ảnh gọn hơn, dễ nhận trên màu nền cụm từ."
          }
        }
      }
    },
