    "Check that you are in the correct landscape orientation (home button / USB-C on the right).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that you are in the correct landscape orientation (home button / USB-C on the right)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compruebe la orientación horizontal correcta (botón de inicio / USB-C a la derecha)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le paysage correct (bouton d’accueil / USB-C à droite)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie das richtige Querformat (Home / USB-C rechts)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من الاتجاه الأفقي الصحيح (زر الشاشة الرئيسية / USB-C يمينًا)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认横屏方向正确（主屏幕按钮 / USB-C 在右）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認橫向方向正確（主畫面按鈕 / USB-C 在右）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
