    "language.follow_system.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app language follows the iPad Settings language when it is supported. Otherwise English is used."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma de la app sigue el idioma de Ajustes del iPad cuando está disponible. Si no, se usa inglés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue de l’app suit la langue des Réglages iPad lorsqu’elle est prise en charge. Sinon, l’anglais est utilisé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App-Sprache folgt der iPad-Einstellungssprache, wenn sie unterstützt wird. Andernfalls wird Englisch verwendet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبع لغة التطبيق لغة إعدادات الـ iPad عندما تكون مدعومة. وإلا تُستخدم الإنجليزية."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用语言会跟随 iPad 设置中的语言（若受支持）。否则使用英语。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 語言會跟隨 iPad 設定中的語言（若支援）。否則使用英語。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応している場合、アプリの言語は iPad の設定言語に従います。それ以外は英語を使います。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngôn ngữ ứng dụng theo ngôn ngữ Cài đặt iPad khi được hỗ trợ. Nếu không, dùng tiếng Anh."
          }
        }
      }
    },
    "Languages": {
      "extractionState": "manual",
      "localizations": {
        "en": {
