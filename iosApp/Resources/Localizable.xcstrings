    "Head Tracking mode: move your head in the direction you want the cursor to go. Moving your head left moves the cursor left, right moves right, up moves up, and down moves down.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Head Tracking mode: move your head in the direction you want the cursor to go. Moving your head left moves the cursor left, right moves right, up moves up, and down moves down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo cabeza: mueva la cabeza hacia donde quiera el cursor. Izquierda, derecha, arriba y abajo mueven el cursor igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode tête : bougez la tête dans la direction souhaitée du curseur. Gauche, droite, haut et bas déplacent le curseur de même."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopfmodus: Kopf in die gewünschte Zeigerrichtung bewegen. Links, rechts, oben, unten entsprechend."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وضع الرأس: حرّك رأسك باتجاه المؤشر. اليسار واليمين والأعلى والأسفل تحرك المؤشر بالمثل."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "头部追踪：头往哪边，光标就往哪边。左、右、上、下对应移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頭部追蹤：頭往哪邊，游標就往哪邊。左、右、上、下對應移動。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭の追跡: カーソルを動かしたい方向へ頭を動かします。左・右・上・下に合わせます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ theo dõi đầu: xoay đầu theo hướng muốn con trỏ đi. Trái, phải, lên, xuống tương ứng."
          }
        }
      }
    },
