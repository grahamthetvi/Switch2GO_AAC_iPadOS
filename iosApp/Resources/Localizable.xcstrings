    "Search Wikimedia Commons for thousands of free images — real photographs, not abstract icons — which are much better for users with CVI.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search Wikimedia Commons for thousands of free images — real photographs, not abstract icons — which are much better for users with CVI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque en Wikimedia Commons miles de imágenes libres: fotos reales, no iconos abstractos, mucho mejores para usuarios con CVI."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cherchez sur Wikimedia Commons des milliers d’images libres — de vraies photos, pas des icônes abstraites — bien meilleures pour le CVI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsuchen Sie Wikimedia Commons nach Tausenden freien Bildern — echte Fotos, keine abstrakten Icons — besser für CVI."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث في ويكيميديا كومنز عن آلاف الصور المجانية — صور حقيقية لا أيقونات مجردة — وهي أفضل بكثير لمستخدمي CVI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在维基共享资源搜索数千张免费图片——真实照片而非抽象图标，更适合 CVI 用户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在維基共享資源搜尋數千張免費圖片——真實照片而非抽象圖示，更適合 CVI 使用者。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィキメディア・コモンズで無料の写真を探せます。抽象アイコンではなく実写で、CVIの人にわかりやすいです。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm trên Wikimedia Commons hàng nghìn ảnh miễn phí — ảnh thật, không phải biểu tượng trừu tượng — tốt hơn nhiều cho người CVI."
          }
        }
      }
    },
