    "Once you're happy with the result, download the image and assign it to your phrase.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once you're happy with the result, download the image and assign it to your phrase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando le guste el resultado, descargue la imagen y asígnela a la frase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand le résultat vous convient, téléchargez l’image et assignez-la à la phrase."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn das Ergebnis passt, laden Sie das Bild herunter und weisen Sie es der Phrase zu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما تعجبك النتيجة نزّل الصورة وعيّنها للعبارة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "满意后下载图片并指定给语句。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滿意後下載圖片並指定給語句。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気に入ったら画像をダウンロードしてフレーズに付けます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi hài lòng, tải ảnh và gán cho cụm từ."
          }
        }
      }
    },
    "Open Edit Categories & Phrases, choose a category, then tap Export Category. Recently Said cannot be exported.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Edit Categories & Phrases, choose a category, then tap Export Category. Recently Said cannot be exported."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Editar categorías y frases, elija una categoría y pulse Exportar categoría. Dicho recientemente no se puede exportar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Modifier catégories et phrases, choisissez une catégorie, puis Exporter la catégorie. Dits récemment ne peut pas être exporté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie Kategorien und Phrasen bearbeiten, wählen Sie eine Kategorie und tippen Sie auf Kategorie exportieren. Zuletzt gesagt kann nicht exportiert werden."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح تعديل الفئات والعبارات، اختر فئة، ثم اضغط تصدير الفئة. «قيل مؤخرًا» لا يمكن تصديره."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“编辑类别和语句”，选择一个类别，然后点“导出类别”。“最近说过”无法导出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「編輯類別與語句」，選擇一個類別，然後點「匯出類別」。「最近說過」無法匯出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「カテゴリとフレーズを編集」を開き、カテゴリを選んで「カテゴリを書き出す」。さいきんいったことは書き出せません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Sửa danh mục và cụm từ, chọn danh mục, rồi chạm Xuất danh mục. Vừa nói không xuất được."
          }
        }
      }
    },
