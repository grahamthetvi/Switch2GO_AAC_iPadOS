    },
    "Some interactive activities require an updated version of Switch2GO. Phrase text and colors will still import.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some interactive activities require an updated version of Switch2GO. Phrase text and colors will still import."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas actividades interactivas requieren una versión actualizada de Switch2GO. El texto y los colores de las frases se importarán igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines activités interactives nécessitent une version plus récente de Switch2GO. Le texte et les couleurs des phrases s’importeront quand même."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige interaktive Aktivitäten erfordern eine neuere Switch2GO-Version. Phrasentext und Farben werden trotzdem importiert."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعض الأنشطة التفاعلية تحتاج إصدارًا أحدث من Switch2GO. سيُستورد نص العبارات وألوانها رغم ذلك."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分互动活动需要更新版 Switch2GO。语句文本和颜色仍会导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分互動活動需要更新版 Switch2GO。語句文字與顏色仍會匯入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のインタラクティブ機能は新しいSwitch2GOが必要です。フレーズの文言と色は取り込めます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số hoạt động tương tác cần bản Switch2GO mới hơn. Chữ và màu cụm từ vẫn được nhập."
          }
        }
      }
    },
