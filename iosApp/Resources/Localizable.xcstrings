    "Creates a .switch2go file you can send by Mail, AirDrop, or Files. Videos should be 20 seconds or shorter. Files larger than 24.75 MB may not send by school email.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a .switch2go file you can send by Mail, AirDrop, or Files. Videos should be 20 seconds or shorter. Files larger than 24.75 MB may not send by school email."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un archivo .switch2go para Mail, AirDrop o Archivos. Los vídeos deben durar 20 segundos o menos. Los archivos de más de 24,75 MB pueden no enviarse por correo escolar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée un fichier .switch2go à envoyer par Mail, AirDrop ou Fichiers. Vidéos de 20 s ou moins. Au-delà de 24,75 Mo, l’e-mail scolaire peut refuser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt eine .switch2go-Datei für Mail, AirDrop oder Dateien. Videos sollten 20 Sekunden oder kürzer sein. Dateien über 24,75 MB kommen per Schul-E-Mail oft nicht an."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينشئ ملف ‎.switch2go يمكن إرساله بالبريد أو AirDrop أو الملفات. يُفضَّل ألا يتجاوز الفيديو 20 ثانية. الملفات الأكبر من 24.75 ميغابايت قد لا تُرسل بالبريد المدرسي."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建一个可通过邮件、隔空投送或“文件”发送的 .switch2go 文件。视频应不超过 20 秒。大于 24.75 MB 的文件可能无法通过学校邮箱发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立一個可透過郵件、AirDrop 或「檔案」傳送的 .switch2go 檔。影片應在 20 秒以內。大於 24.75 MB 的檔案可能無法用學校郵件寄出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ".switch2goファイルを作り、メール、AirDrop、ファイルで送れます。動画は20秒以内。24.75MB超は学校メールで送れないことがあります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo tệp .switch2go gửi bằng Mail, AirDrop hoặc Tệp. Video nên từ 20 giây trở xuống. Tệp lớn hơn 24,75 MB có thể không gửi được bằng email trường."
          }
        }
      }
    },
    "Creates a JSON file you can share or save to Files.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
