    "Uses %d phrases per page from Display settings. Each switch speaks one tile (left-to-right, top-to-bottom).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses %d phrases per page from Display settings. Each switch speaks one tile (left-to-right, top-to-bottom)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa %d frases por página de Ajustes de visualización. Cada interruptor dice una casilla (izquierda a derecha, arriba a abajo)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise %d phrases par page d’après Affichage. Chaque switch dit une case (gauche à droite, haut en bas)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet %d Phrasen pro Seite aus den Anzeigeeinstellungen. Jeder Schalter spricht eine Kachel (links nach rechts, oben nach unten)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم %d عبارات في الصفحة من إعدادات العرض. كل مفتاح ينطق بلاطة واحدة (من اليسار إلى اليمين، من الأعلى إلى الأسفل)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用显示设置中的每页 %d 条语句。每个开关朗读一个格子（从左到右、从上到下）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用顯示設定中的每頁 %d 條語句。每個開關朗讀一個格子（由左至右、由上至下）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示設定の1ページあたり %d フレーズを使います。各スイッチは1つのタイルを読み上げます（左から右、上から下）。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng %d cụm từ mỗi trang từ cài đặt Hiển thị. Mỗi công tắc nói một ô (trái sang phải, trên xuống dưới)."
          }
        }
      }
    },
