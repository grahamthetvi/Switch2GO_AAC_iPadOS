    "Pair Switch2GO-XXXX in iPad Settings → Bluetooth (not inside this app).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair Switch2GO-XXXX in iPad Settings → Bluetooth (not inside this app)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empareje Switch2GO-XXXX en Ajustes del iPad → Bluetooth (no dentro de esta app)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appariez Switch2GO-XXXX dans Réglages iPad → Bluetooth (pas dans cette app)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppeln Sie Switch2GO-XXXX unter iPad-Einstellungen → Bluetooth (nicht in dieser App)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اربط Switch2GO-XXXX في إعدادات الـ iPad ← بلوتوث (وليس داخل هذا التطبيق)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPad 设置 → 蓝牙中配对 Switch2GO-XXXX（不要在本应用内）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPad 設定 → 藍牙中配對 Switch2GO-XXXX（不要在本 App 內）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad設定 → BluetoothでSwitch2GO-XXXXをペアリング（このアプリ内ではありません）。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghép Switch2GO-XXXX trong Cài đặt iPad → Bluetooth (không trong ứng dụng này)."
          }
        }
      }
    },
    "Pair Switch2GO-XXXX in iPad Settings → Bluetooth, then press a wired switch (or use BOOT multi-tap).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair Switch2GO-XXXX in iPad Settings → Bluetooth, then press a wired switch (or use BOOT multi-tap)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empareje Switch2GO-XXXX en Ajustes del iPad → Bluetooth y pulse un interruptor (o multi-toque BOOT)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appariez Switch2GO-XXXX dans Réglages iPad → Bluetooth, puis appuyez sur un switch (ou multi-appui BOOT)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppeln Sie Switch2GO-XXXX unter iPad-Einstellungen → Bluetooth, dann Schalter drücken (oder BOOT-Mehrfachtipp)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اربط Switch2GO-XXXX في إعدادات الـ iPad ← بلوتوث، ثم اضغط مفتاحًا سلكيًا (أو نقرات BOOT المتعددة)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPad 设置 → 蓝牙中配对 Switch2GO-XXXX，然后按下有线开关（或使用 BOOT 连按）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPad 設定 → 藍牙中配對 Switch2GO-XXXX，然後按下有線開關（或使用 BOOT 連按）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad設定 → BluetoothでSwitch2GO-XXXXをペアリングし、有線スイッチを押す（またはBOOTの連続タップ）。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghép Switch2GO-XXXX trong Cài đặt iPad → Bluetooth, rồi nhấn công tắc (hoặc nhấn BOOT nhiều lần)."
          }
        }
      }
    },
    "Pair the ESP32 as Switch2GO-XXXX in iPad Settings → Bluetooth before using the app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair the ESP32 as Switch2GO-XXXX in iPad Settings → Bluetooth before using the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empareje el ESP32 como Switch2GO-XXXX en Ajustes del iPad → Bluetooth antes de usar la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appariez l’ESP32 en Switch2GO-XXXX dans Réglages iPad → Bluetooth avant d’utiliser l’app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ESP32 als Switch2GO-XXXX unter iPad-Einstellungen → Bluetooth koppeln, bevor Sie die App nutzen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اربط ESP32 باسم Switch2GO-XXXX في إعدادات الـ iPad ← بلوتوث قبل استخدام التطبيق."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用应用前，在 iPad 设置 → 蓝牙中将 ESP32 配对为 Switch2GO-XXXX。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 App 前，在 iPad 設定 → 藍牙中將 ESP32 配對為 Switch2GO-XXXX。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを使う前に、iPad設定 → BluetoothでESP32をSwitch2GO-XXXXとしてペアリングします。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghép ESP32 thành Switch2GO-XXXX trong Cài đặt iPad → Bluetooth trước khi dùng ứng dụng."
          }
        }
      }
    },
    "Paste a valid YouTube link or 11-character video ID.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste a valid YouTube link or 11-character video ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegue un enlace de YouTube válido o un ID de 11 caracteres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez un lien YouTube valide ou un ID de 11 caractères."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie einen gültigen YouTube-Link oder eine 11-stellige Video-ID ein."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق رابط يوتيوب صالحًا أو معرّف فيديو من 11 حرفًا."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请粘贴有效的 YouTube 链接或 11 位视频 ID。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請貼上有效的 YouTube 連結或 11 字元影片 ID。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なYouTubeリンクまたは11文字の動画IDを貼ってください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dán liên kết YouTube hợp lệ hoặc ID video 11 ký tự."
          }
        }
      }
    },
    "Paste a YouTube link or 11-character video ID. Playback uses the same fullscreen gaze controls as uploaded video.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste a YouTube link or 11-character video ID. Playback uses the same fullscreen gaze controls as uploaded video."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegue un enlace de YouTube o un ID de 11 caracteres. La reproducción usa los mismos controles de mirada a pantalla completa que el vídeo subido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez un lien YouTube ou un ID de 11 caractères. La lecture utilise les mêmes commandes du regard en plein écran que la vidéo importée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie einen YouTube-Link oder eine 11-stellige Video-ID ein. Die Wiedergabe nutzt dieselben Vollbild-Blicksteuerungen wie hochgeladenes Video."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق رابط يوتيوب أو معرّف فيديو من 11 حرفًا. التشغيل يستخدم عناصر تحكم النظرة بملء الشاشة نفسها كالفيديو المرفوع."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴 YouTube 链接或 11 位视频 ID。播放使用与上传视频相同的全屏注视控件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上 YouTube 連結或 11 字元影片 ID。播放使用與上傳影片相同的全螢幕注視控制。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTubeのリンクまたは11文字の動画IDを貼ります。再生はアップロード動画と同じ全画面の視線操作です。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dán liên kết YouTube hoặc ID video 11 ký tự. Phát dùng cùng điều khiển nhìn toàn màn hình như video tải lên."
          }
        }
      }
    },
