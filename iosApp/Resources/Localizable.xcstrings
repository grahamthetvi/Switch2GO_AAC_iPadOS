    "How long to wait after selecting a phrase before playing attached video, audio, or a game, if no other phrase is selected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long to wait after selecting a phrase before playing attached video, audio, or a game, if no other phrase is selected"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto esperar tras seleccionar una frase antes de reproducir vídeo, audio o un juego, si no se elige otra"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien attendre après une phrase avant de lire vidéo, audio ou un jeu, si aucune autre n’est choisie"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartezeit nach Phrasenauswahl, bevor Video, Audio oder ein Spiel startet, wenn keine andere Phrase gewählt wird"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مدة الانتظار بعد اختيار عبارة قبل تشغيل فيديو أو صوت أو لعبة، إن لم تُختر عبارة أخرى"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择语句后，若未再选其他语句，等待多久再播放附加的视频、音频或游戏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇語句後，若未再選其他語句，等待多久再播放附加的影片、音訊或遊戲"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレーズを選んだあと、他を選ばなければ、付いている動画・音声・ゲームを再生するまでの待ち時間"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi chọn cụm từ, chờ bao lâu trước khi phát video, âm thanh hoặc trò chơi đính kèm nếu không chọn cụm khác"
          }
        }
      }
    },
