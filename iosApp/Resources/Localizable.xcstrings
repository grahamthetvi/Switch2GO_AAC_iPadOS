    "Make sure your face is clearly visible to the front camera -- avoid covering your face or wearing reflective glasses.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure your face is clearly visible to the front camera -- avoid covering your face or wearing reflective glasses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrese de que la cara se vea bien: no la cubra ni use gafas muy reflectantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le visage doit être bien visible — évitez de le couvrir ou les lunettes très réfléchissantes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gesicht muss klar sichtbar sein — nicht verdecken, keine stark spiegelnden Brillen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد أن وجهك ظاهر للكاميرا الأمامية — تجنب تغطيته أو النظارات العاكسة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确保面部清晰可见——不要遮挡或戴强反光眼镜。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請確保臉部清晰可見——不要遮擋或戴強反光眼鏡。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "顔が前面カメラにはっきり見えるように。顔を隠したり、反射の強い眼鏡は避けてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy để mặt rõ trước camera trước — đừng che mặt hoặc đeo kính phản quang mạnh."
          }
        }
      }
    },
    "Make sure your face is in view and well lit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure your face is in view and well lit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrese de que su cara se vea y esté bien iluminada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veillez à ce que votre visage soit visible et bien éclairé"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie sicher, dass Ihr Gesicht sichtbar und gut beleuchtet ist"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد أن وجهك ظاهر ومضاء جيدًا"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确保面部在画面中且光线充足"
          }
        },
        "zh-Hant": {
