    },
    "The phrase pack contains an unsafe file path and was not imported.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phrase pack contains an unsafe file path and was not imported."
          }
        },
        "es": {
