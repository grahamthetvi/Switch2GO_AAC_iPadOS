    "In both tracking modes, the blue cursor shows the current pointer location and the green progress ring fills while you dwell.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In both tracking modes, the blue cursor shows the current pointer location and the green progress ring fills while you dwell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En ambos modos, el cursor azul muestra el puntero y el anillo verde se llena al permanecer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans les deux modes, le curseur bleu indique le pointeur et l’anneau vert se remplit pendant le maintien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In beiden Modi zeigt der blaue Zeiger die Position; der grüne Ring füllt sich beim Verweilen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في وضعي التتبع يظهر المؤشر الأزرق الموقع وتمتلئ الحلقة الخضراء أثناء المكوث."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两种追踪模式下，蓝色光标显示指针位置，绿色进度环在停留时填充。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩種追蹤模式下，藍色游標顯示指標位置，綠色進度環在停留時填滿。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どちらの追跡でも青いカーソルが位置を示し、滞留中に緑のリングが満ちます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ở cả hai chế độ, con trỏ xanh dương hiện vị trí và vòng xanh lá đầy khi bạn nhìn."
          }
        }
      }
    },
