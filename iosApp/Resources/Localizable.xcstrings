    "All of these options are available in the Phrase Style Editor when you edit any phrase in Settings → Edit Categories & Phrases.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All of these options are available in the Phrase Style Editor when you edit any phrase in Settings → Edit Categories & Phrases."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas estas opciones están en el editor de estilo al editar cualquier frase en Ajustes → Editar categorías y frases."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
