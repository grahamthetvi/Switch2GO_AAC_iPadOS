    "Save or restore your categories, phrases, styles, images, and media. Backups are primarily for the same iPad app (not interchangeable with the web app yet).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save or restore your categories, phrases, styles, images, and media. Backups are primarily for the same iPad app (not interchangeable with the web app yet)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde o restaure categorías, frases, estilos, imágenes y multimedia. Las copias son principalmente para la misma app de iPad (aún no intercambiables con la web)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez ou restaurez catégories, phrases, styles, images et médias. Sauvegardes surtout pour la même app iPad (pas encore interchangeables avec le web)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorien, Phrasen, Stile, Bilder und Medien sichern oder wiederherstellen. Backups vor allem für dieselbe iPad-App (noch nicht mit der Web-App austauschbar)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ أو استعد الفئات والعبارات والأنماط والصور والوسائط. النسخ الاحتياطية مخصصة أساسًا لنفس تطبيق الـ iPad (غير قابلة للتبادل مع الويب بعد)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存或还原类别、语句、样式、图片和媒体。备份主要用于同一 iPad 应用（尚不能与网页版互换）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存或還原類別、語句、樣式、圖片與媒體。備份主要用於同一 iPad App（尚不能與網頁版互換）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カテゴリ、フレーズ、スタイル、画像、メディアを保存または復元します。バックアップは主に同じiPadアプリ向けです（ウェブ版とはまだ互換ではありません）。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu hoặc khôi phục danh mục, cụm từ, kiểu, ảnh và phương tiện. Bản sao lưu chủ yếu cho cùng app iPad (chưa đổi với bản web)."
          }
        }
      }
    },
