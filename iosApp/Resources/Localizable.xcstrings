    "Connected, but this firmware has no PowerLink output. Reflash ESP32/Switch2GO_BLE_Switch, then Forget Device and pair again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected, but this firmware has no PowerLink output. Reflash ESP32/Switch2GO_BLE_Switch, then Forget Device and pair again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado, pero este firmware no tiene salida PowerLink. Vuelva a flashear ESP32/Switch2GO_BLE_Switch, olvide el dispositivo y empareje de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté, mais ce micrologiciel n’a pas de sortie PowerLink. Reflashez ESP32/Switch2GO_BLE_Switch, oubliez l’appareil et appariez à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbunden, aber diese Firmware hat keinen PowerLink-Ausgang. ESP32/Switch2GO_BLE_Switch neu flashen, Gerät vergessen und erneut koppeln."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متصل، لكن هذا البرنامج الثابت بلا خرج PowerLink. أعد تحميل ESP32/Switch2GO_BLE_Switch ثم انسَ الجهاز واربطه من جديد."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接，但此固件没有 PowerLink 输出。请重新刷写 ESP32/Switch2GO_BLE_Switch，然后忘记设备并重新配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已連線，但此韌體沒有 PowerLink 輸出。請重新刷寫 ESP32/Switch2GO_BLE_Switch，然後忘記裝置並重新配對。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続済みですが、このファームウェアにはPowerLink出力がありません。ESP32/Switch2GO_BLE_Switchを書き直し、デバイスを忘れて再ペアリングしてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã kết nối nhưng firmware này không có ngõ ra PowerLink. Nạp lại ESP32/Switch2GO_BLE_Switch, rồi Quên thiết bị và ghép lại."
          }
        }
      }
    },
