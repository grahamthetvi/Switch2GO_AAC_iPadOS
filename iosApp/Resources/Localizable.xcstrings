    "Dwell on bright blocks to break them and reveal your phrase. Eye-gaze training with particles and confetti.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwell on bright blocks to break them and reveal your phrase. Eye-gaze training with particles and confetti."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanezca en bloques brillantes para romperlos y revelar su frase. Entrenamiento de mirada con partículas y confeti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez le regard sur des blocs lumineux pour les casser et révéler votre phrase. Entraînement du regard avec particules et confettis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verweilen Sie auf hellen Blöcken, um sie zu zerbrechen und die Phrase zu zeigen. Blicktraining mit Partikeln und Konfetti."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امكث على المكعبات الساطعة لكسرها وإظهار عبارتك. تدريب للنظرة مع جزيئات وقصاصات."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注视亮色方块以击碎并显示语句。眼动训练，带粒子和彩纸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "注視亮色方塊以擊碎並顯示語句。眼球訓練，帶粒子與彩紙。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明るいブロックを見つめて壊し、フレーズを出します。視線の練習（粒子と紙吹雪）。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhìn khối sáng để phá và hiện cụm từ. Luyện nhìn với hạt và confetti."
          }
        }
      }
    },
