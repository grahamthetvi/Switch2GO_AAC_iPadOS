          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセルできる最後の機会です。カスタムデータは失われます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là lần hủy cuối. Mọi dữ liệu tùy chỉnh sẽ mất mãi."
          }
        }
      }
    },
