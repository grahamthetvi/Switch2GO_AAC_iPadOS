    "Huge bullseye targets in five screen positions. Dwell to splat a cream pie with synthesized reward sound.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Huge bullseye targets in five screen positions. Dwell to splat a cream pie with synthesized reward sound."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grandes dianas en cinco posiciones. Permanezca para lanzar un pastel de nata con sonido de recompensa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grandes cibles en cinq positions. Maintenez le regard pour éclater une tarte à la crème avec un son de récompense."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Große Zielscheiben an fünf Positionen. Verweilen, um eine Sahnetorte zu treffen – mit Belohnungston."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أهداف كبيرة في خمسة مواضع. امكث لترمي فطيرة كريمة مع صوت مكافأة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "五个位置的巨大靶心。注视以砸奶油派并播放奖励音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "五個位置的巨大靶心。注視以砸奶油派並播放獎勵音。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の5か所に大きな的。見つめてクリームパイを当て、ごほうび音が鳴ります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bia lớn ở năm vị trí màn hình. Nhìn để ném bánh kem với âm thanh thưởng."
          }
        }
      }
    },
