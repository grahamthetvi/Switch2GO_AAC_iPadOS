    "The app has been reset to defaults. All custom data has been removed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app has been reset to defaults. All custom data has been removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app se ha restablecido. Se han eliminado todos los datos personalizados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app a été réinitialisée. Toutes les données personnalisées ont été supprimées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App wurde auf Standard zurückgesetzt. Alle eigenen Daten wurden entfernt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُعيد التطبيق إلى الافتراضي. أُزيلت كل البيانات المخصصة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用已重置为默认。所有自定义数据已移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 已重設為預設。所有自訂資料已移除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリは初期状態に戻り、カスタムデータは削除されました。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng đã về mặc định. Mọi dữ liệu tùy chỉnh đã bị gỡ."
          }
        }
      }
    },
    "The change takes effect immediately when you close Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change takes effect immediately when you close Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cambio se aplica al cerrar Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le changement s’applique dès que vous fermez Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Änderung gilt sofort nach Schließen der Einstellungen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسري التغيير فور إغلاق الإعدادات."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭设置后立即生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉設定後立即生效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を閉じるとすぐに反映されます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi có hiệu lực ngay khi đóng Cài đặt."
          }
        }
      }
    },
    "The CVI Display Settings let you control how many phrase symbols appear on each page. Fewer symbols means less visual clutter — choose between 2, 3, or 4 symbols per page.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The CVI Display Settings let you control how many phrase symbols appear on each page. Fewer symbols means less visual clutter — choose between 2, 3, or 4 symbols per page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes de pantalla CVI controlan cuántos símbolos de frase hay por página. Menos símbolos, menos desorden: elija 2, 3 o 4."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages d’affichage CVI contrôlent le nombre de symboles par page. Moins de symboles, moins de charge : 2, 3 ou 4."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CVI-Anzeigeeinstellungen steuern, wie viele Phrasensymbole pro Seite erscheinen. Weniger Symbole, weniger Durcheinander — 2, 3 oder 4."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتيح إعدادات عرض CVI التحكم بعدد رموز العبارات في الصفحة. رموز أقل تعني فوضى أقل — اختر 2 أو 3 أو 4."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CVI 显示设置可控制每页出现多少语句符号。符号越少越不杂乱——可选每页 2、3 或 4 个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CVI 顯示設定可控制每頁出現多少語句符號。符號越少越不雜亂——可選每頁 2、3 或 4 個。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CVI表示設定で1ページの記号数を決めます。少ないほど見やすいです。2、3、4から選べます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt hiển thị CVI cho phép chọn số ký hiệu cụm từ mỗi trang. Ít ký hiệu thì đỡ rối — chọn 2, 3 hoặc 4."
          }
        }
      }
    },
    "The front-facing camera should be on the left side, facing you.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The front-facing camera should be on the left side, facing you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara frontal debe quedar a la izquierda, mirándole."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caméra avant doit être à gauche, face à vous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Frontkamera sollte links sein und zu Ihnen zeigen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تكون الكاميرا الأمامية على اليسار ومواجهة لك."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前置摄像头应在左侧朝向您。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前置相機應在左側朝向您。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前面カメラは左側で、あなたを向きます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera trước nên ở bên trái, hướng về bạn."
          }
        }
      }
    },
    "The Image Tool": {
      "extractionState": "manual",
      "localizations": {
        "en": {
