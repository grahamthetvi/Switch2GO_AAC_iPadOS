    "Arm raise selection works with 2 phrases per page (left and right). Change layout in Settings → CVI Display.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arm raise selection works with 2 phrases per page (left and right). Change layout in Settings → CVI Display."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La selección por levantar el brazo funciona con 2 frases por página (izquierda y derecha). Cambie el diseño en Ajustes → Pantalla CVI."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sélection par lever de bras fonctionne avec 2 phrases par page (gauche et droite). Changez la mise en page dans Réglages → Affichage CVI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Armheben-Auswahl funktioniert mit 2 Phrasen pro Seite (links und rechts). Layout unter Einstellungen → CVI-Anzeige ändern."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل التحديد برفع الذراع مع عبارتين في الصفحة (يسار ويمين). غيّر التخطيط في الإعدادات ← عرض CVI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
