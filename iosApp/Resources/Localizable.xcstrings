    "No camera images, video, or eye tracking data is stored or transmitted. No audio recordings are stored or transmitted. All processing happens locally on your device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No camera images, video, or eye tracking data is stored or transmitted. No audio recordings are stored or transmitted. All processing happens locally on your device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se almacenan ni transmiten imágenes de cámara, vídeo ni datos de seguimiento ocular. No se almacenan ni transmiten grabaciones. Todo el procesamiento es local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune image caméra, vidéo ni donnée de suivi oculaire n’est stockée ou transmise. Aucun enregistrement audio. Tout le traitement est local."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Kamerabilder, Videos oder Blickdaten werden gespeichert oder übertragen. Keine Audioaufnahmen. Alle Verarbeitung lokal."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُخزَّن ولا تُرسل صور كاميرا أو فيديو أو بيانات تتبع العين. لا تسجيلات صوتية. كل المعالجة محلية على جهازك."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会存储或传输摄像头图像、视频或眼动数据。不会存储或传输录音。所有处理均在设备本地完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會儲存或傳輸相機影像、影片或眼球追蹤資料。不會儲存或傳輸錄音。所有處理均在裝置本機完成。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラ画像、動画、視線データは保存も送信もしません。録音も保存・送信しません。処理はすべて端末内です。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không lưu hay truyền ảnh camera, video hay dữ liệu theo dõi mắt. Không lưu hay truyền bản ghi âm. Mọi xử lý diễn ra trên thiết bị."
          }
        }
      }
    },
