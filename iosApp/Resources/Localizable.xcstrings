    "Use 2 switches to move a highlight across phrases, then select. Works with or without auto-scan.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 2 switches to move a highlight across phrases, then select. Works with or without auto-scan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 2 interruptores para mover el resaltado y luego seleccionar. Funciona con o sin barrido automático."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez 2 switches pour déplacer le surlignage, puis sélectionner. Avec ou sans balayage auto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit 2 Schaltern die Hervorhebung bewegen und dann auswählen. Mit oder ohne Auto-Scan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم مفتاحين لتحريك التمييز ثم التحديد. يعمل مع المسح التلقائي أو بدونه."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 2 个开关移动高亮再选择。可配合或不配合自动扫描。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 2 個開關移動反白再選擇。可搭配或不搭配自動掃描。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スイッチ2つでハイライトを動かして選びます。自動スキャンの有無どちらでも使えます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng 2 công tắc để chuyển vùng sáng rồi chọn. Có hoặc không tự quét."
          }
        }
      }
    },
    "Use 2–4 switches; each switch speaks the phrase in that grid position.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 2–4 switches; each switch speaks the phrase in that grid position."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Use de 2 a 4 interruptores; cada uno dice la frase de esa posición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez 2 à 4 switches ; chacun dit la phrase de cette case."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit 2–4 Schaltern; jeder spricht die Phrase an dieser Position."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم من 2 إلى 4 مفاتيح؛ كل مفتاح ينطق عبارة ذلك الموضع."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 2–4 个开关；每个开关朗读该格子的语句。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 2–4 個開關；每個開關朗讀該格子的語句。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スイッチ2〜4個。各スイッチがその位置のフレーズを読み上げます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng 2–4 công tắc; mỗi cái nói cụm từ ở ô đó."
          }
        }
      }
    },
    "Use a BLACK background — dark backgrounds reduce visual clutter and help the foreground content stand out.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a BLACK background — dark backgrounds reduce visual clutter and help the foreground content stand out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Use fondo NEGRO: los fondos oscuros reducen el desorden visual y destacan el contenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un fond NOIR — les fonds sombres réduisent le bruit visuel et font ressortir le contenu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwarzen Hintergrund verwenden — dunkle Hintergründe reduzieren visuelles Durcheinander."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم خلفية سوداء — الخلفيات الداكنة تقلل الفوضى البصرية وتبرز المحتوى."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用黑色背景——深色背景减少视觉杂乱，让前景更突出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用黑色背景——深色背景減少視覺雜亂，讓前景更突出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景は黒に。暗い背景はごちゃつきを減らし、手前が目立ちます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng nền ĐEN — nền tối giảm rối mắt và làm nổi nội dung."
          }
        }
      }
    },
