    "Games are not available in arm raise mode. Switch to eye gaze, head tracking, or touch only in Settings → Selection Mode.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Games are not available in arm raise mode. Switch to eye gaze, head tracking, or touch only in Settings → Selection Mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los juegos no están disponibles en el modo de levantar el brazo. Cambie a mirada, cabeza o solo toque en Ajustes → Modo de selección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jeux ne sont pas disponibles en mode lever de bras. Passez au regard, à la tête ou au toucher seul dans Réglages → Mode de sélection."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele sind im Armheben-Modus nicht verfügbar. Wechseln Sie zu Blick, Kopf oder nur Touch unter Einstellungen → Auswahlmodus."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الألعاب غير متاحة في وضع رفع الذراع. انتقل إلى النظرة أو الرأس أو اللمس فقط في الإعدادات ← وضع التحديد."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "举手模式下无法使用游戏。请在设置 → 选择模式中改为眼动、头部追踪或仅触摸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舉手模式下無法使用遊戲。請在設定 → 選擇模式中改為眼球、頭部追蹤或僅觸控。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腕上げモードではゲームは使えません。設定 → 選択モードで視線、頭の追跡、またはタッチのみにしてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không chơi được ở chế độ giơ tay. Đổi sang nhìn, theo dõi đầu hoặc chỉ chạm trong Cài đặt → Chế độ chọn."
          }
        }
      }
    },
