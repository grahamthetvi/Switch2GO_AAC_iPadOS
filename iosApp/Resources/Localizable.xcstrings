    "Tap the gear icon in the top-right corner to open Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the gear icon in the top-right corner to open Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque el engranaje arriba a la derecha para abrir Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez l’engrenage en haut à droite pour ouvrir Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie oben rechts auf das Zahnrad, um Einstellungen zu öffnen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط أيقونة الترس أعلى اليمين لفتح الإعدادات."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点右上角齿轮打开设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點右上角齒輪開啟設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上の歯車をタップして設定を開きます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm bánh răng góc trên phải để mở Cài đặt."
          }
        }
      }
    },
    "Tap to enter emoji": {
      "extractionState": "manual",
