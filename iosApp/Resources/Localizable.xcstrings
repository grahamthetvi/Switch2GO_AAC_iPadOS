    "A banner will appear when you rotate, telling you which modes are available in the current orientation.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A banner will appear when you rotate, telling you which modes are available in the current orientation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al girar aparecerá un aviso indicando qué modos hay en esa orientación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une bannière indique les modes disponibles dans l’orientation actuelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Drehen erscheint ein Banner mit den verfügbaren Modi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند الدوران يظهر شريط يوضح الأوضاع المتاحة في الاتجاه الحالي."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旋转时会出现横幅，说明当前方向可用的模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "旋轉時會出現橫幅，說明目前方向可用的模式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "向きを変えると、今使えるモードを示すバナーが出ます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi xoay sẽ có banner cho biết chế độ nào dùng được ở hướng hiện tại."
          }
        }
      }
    },
    "A category named \"%@\" already exists. Importing will add another copy unless you merge into the existing category.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A category named \"%@\" already exists. Importing will add another copy unless you merge into the existing category."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe una categoría llamada \"%@\". Al importar se añadirá otra copia, salvo que la combine con la existente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une catégorie nommée « %@ » existe déjà. L’importation ajoutera une autre copie, sauf si vous fusionnez avec la catégorie existante."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kategorie namens „%@“ existiert bereits. Der Import fügt eine weitere Kopie hinzu, sofern Sie nicht in die vorhandene Kategorie zusammenführen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توجد فئة باسم \"%@\" بالفعل. سيضيف الاستيراد نسخة أخرى ما لم تدمجها في الفئة الحالية."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有名为“%@”的类别。导入会再添加一份副本，除非合并到现有类别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有名為「%@」的類別。匯入會再新增一份副本，除非合併到現有類別。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」というカテゴリは既にあります。既存カテゴリに統合しない限り、取り込みはもう1つコピーを追加します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã có danh mục tên \"%@\". Nhập vào sẽ thêm một bản sao trừ khi bạn gộp vào danh mục hiện có."
          }
        }
      }
    },
    "A media file in the pack is larger than 100 MB.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
