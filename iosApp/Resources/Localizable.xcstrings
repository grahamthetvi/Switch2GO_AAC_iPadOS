        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الوضع: بلا تتبع (لمس ومفتاح) أو تتبع الرأس أو تتبع النظرة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
