            "state": "translated",
            "value": "Das Pack enthält ein Bild, das nicht gelesen werden konnte."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحزمة تحتوي صورة تعذر قراءتها."
          }
        },
        "zh-Hans": {
