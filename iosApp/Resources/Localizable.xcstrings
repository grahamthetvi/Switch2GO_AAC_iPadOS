    "Videos must be 20 seconds or shorter. Longer files are not attached.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos must be 20 seconds or shorter. Longer files are not attached."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los vídeos deben durar 20 segundos o menos. Los más largos no se adjuntan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vidéos doivent durer 20 secondes ou moins. Les fichiers plus longs ne sont pas joints."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos dürfen höchstens 20 Sekunden lang sein. Längere Dateien werden nicht angehängt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب ألا يتجاوز الفيديو 20 ثانية. الملفات الأطول لا تُرفق."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频不得超过 20 秒。更长的文件不会附加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影片不得超過 20 秒。更長的檔案不會附加。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画は20秒以内。それより長いファイルは付けません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Video phải từ 20 giây trở xuống. Tệp dài hơn không được đính."
          }
        }
      }
    },
