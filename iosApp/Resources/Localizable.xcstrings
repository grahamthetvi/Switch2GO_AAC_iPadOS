        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "非常好！眼动追踪应该会很顺畅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "非常好！眼球追蹤應該會很順暢。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "とても良いです。視線追跡はうまく働くはずです。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuyệt! Theo dõi mắt sẽ hoạt động rất tốt."
          }
        }
      }
    },
