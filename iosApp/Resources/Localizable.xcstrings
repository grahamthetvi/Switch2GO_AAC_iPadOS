{
  "sourceLanguage": "en",
  "strings": {
    "\"%@\" is a built-in board and cannot be changed by a phrase pack. Rename the incoming category or cancel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" is a built-in board and cannot be changed by a phrase pack. Rename the incoming category or cancel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" es un tablero integrado y un paquete de frases no puede cambiarlo. Cambie el nombre de la categoría entrante o cancele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est un tableau intégré et un pack de phrases ne peut pas le modifier. Renommez la catégorie importée ou annulez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist ein integriertes Board und kann nicht durch ein Phrase-Pack geändert werden. Benennen Sie die eingehende Kategorie um oder brechen Sie ab."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" لوحة مضمّنة ولا يمكن لحزمة عبارات تغييرها. أعد تسمية الفئة الواردة أو ألغِ العملية."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是内置看板，语句包无法更改。请重命名导入的类别或取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」是內建看板，語句包無法變更。請重新命名匯入的類別或取消。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は内蔵ボードのため、フレーズパックでは変更できません。取り込むカテゴリの名前を変えるか、キャンセルしてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" là bảng có sẵn và gói cụm từ không thể thay đổi. Đổi tên danh mục đang nhập hoặc hủy."
          }
        }
      }
    },
