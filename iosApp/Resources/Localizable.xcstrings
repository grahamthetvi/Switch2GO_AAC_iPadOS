    "Eye and head tracking require landscape orientation.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eye and head tracking require landscape orientation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El seguimiento de ojos y cabeza requiere orientación horizontal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le suivi yeux/tête nécessite le mode paysage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blick- und Kopfsteuerung brauchen Querformat."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبع العين والرأس يتطلب الوضع الأفقي."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "眼和头追踪需要横屏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "眼與頭追蹤需要橫向。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目と頭の追跡には横向きが必要です。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi mắt và đầu cần hướng ngang."
          }
        }
      }
    },
    "Eye Gaze mode: keep your head as still as possible and move only your eyes. Look at a button and hold your gaze until the dwell ring completes to select it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eye Gaze mode: keep your head as still as possible and move only your eyes. Look at a button and hold your gaze until the dwell ring completes to select it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo mirada: mantenga la cabeza lo más quieta posible y mueva solo los ojos. Mire un botón y sostenga la mirada hasta que el anillo se complete."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode regard : gardez la tête aussi immobile que possible et ne bougez que les yeux. Regardez un bouton et maintenez le regard jusqu’à ce que l’anneau se remplisse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blickmodus: Kopf möglichst still, nur die Augen bewegen. Auf eine Taste schauen, bis der Ring voll ist."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وضع النظرة: أبقِ رأسك ثابتًا قدر الإمكان وحرّك عينيك فقط. انظر إلى زر وامكث حتى يكتمل الحلقة لتحديده."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "眼动模式：头部尽量不动，只动眼睛。注视按钮直到停留环走完即可选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "眼球模式：頭部盡量不動，只動眼睛。注視按鈕直到停留環走完即可選擇。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "視線モード: 頭はできるだけ動かさず、目だけ動かします。ボタンを見て、リングが終わるまで見つめて選びます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ nhìn: giữ đầu càng yên càng tốt, chỉ chuyển mắt. Nhìn nút và giữ ánh nhìn đến khi vòng đầy để chọn."
          }
        }
      }
    },
