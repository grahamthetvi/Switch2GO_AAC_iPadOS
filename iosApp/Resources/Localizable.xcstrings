    "Choose your preferred mode: No Tracking (Touch & Switch), Head Tracking, or Eye Gaze Tracking.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your preferred mode: No Tracking (Touch & Switch), Head Tracking, or Eye Gaze Tracking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija el modo: Sin seguimiento (toque e interruptor), Seguimiento de cabeza o Mirada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez : Sans suivi (toucher et switch), Suivi de la tête ou Suivi du regard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie: Kein Tracking (Touch & Schalter), Kopfsteuerung oder Blicksteuerung."
          }
