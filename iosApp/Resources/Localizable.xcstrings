    "Default keys are 1–4; key mapping in Switch Control must match ESP32/Switch2GO_BLE_Switch firmware.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default keys are 1–4; key mapping in Switch Control must match ESP32/Switch2GO_BLE_Switch firmware."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las teclas predeterminadas son 1–4; el mapeo en Control por interruptor debe coincidir con el firmware ESP32/Switch2GO_BLE_Switch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touches par défaut 1–4 ; le mappage dans Contrôle par switch doit correspondre au micrologiciel ESP32/Switch2GO_BLE_Switch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardtasten 1–4; die Zuordnung in Schaltersteuerung muss zur Firmware ESP32/Switch2GO_BLE_Switch passen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المفاتيح الافتراضية 1–4؛ يجب أن يطابق التعيين في التحكم بالمفاتيح برنامج ESP32/Switch2GO_BLE_Switch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认按键为 1–4；开关控制中的映射必须与 ESP32/Switch2GO_BLE_Switch 固件一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設按鍵為 1–4；開關控制中的對應必須與 ESP32/Switch2GO_BLE_Switch 韌體一致。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトキーは1〜4。スイッチ操作の割り当てはESP32/Switch2GO_BLE_Switchのファームウェアと合わせてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phím mặc định là 1–4; ánh xạ trong Điều khiển công tắc phải khớp firmware ESP32/Switch2GO_BLE_Switch."
          }
        }
      }
    },
    "Default: keys 1 and 2. Must match your switch device firmware.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default: keys 1 and 2. Must match your switch device firmware."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Predeterminado: teclas 1 y 2. Debe coincidir con el firmware del interruptor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut : touches 1 et 2. Doit correspondre au micrologiciel du switch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard: Tasten 1 und 2. Muss zur Schalter-Firmware passen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الافتراضي: المفتاحان 1 و 2. يجب أن يطابق برنامج جهاز المفتاح."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认：按键 1 和 2。必须与开关设备固件一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設：按鍵 1 和 2。必須與開關裝置韌體一致。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルト: キー1と2。スイッチ機器のファームウェアと合わせてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mặc định: phím 1 và 2. Phải khớp firmware thiết bị công tắc."
          }
        }
      }
    },
    "Default: keys 1–%d. Must match your switch device firmware.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
