    "Enable Switch Control under Settings → Selection Mode → Switch Control.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Switch Control under Settings → Selection Mode → Switch Control."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Active Control por interruptor en Ajustes → Modo de selección → Control por interruptor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Contrôle par switch dans Réglages → Mode de sélection → Contrôle par switch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltersteuerung unter Einstellungen → Auswahlmodus → Schaltersteuerung aktivieren."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل التحكم بالمفاتيح من الإعدادات ← وضع التحديد ← التحكم بالمفاتيح."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置 → 选择模式 → 开关控制中启用开关控制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在設定 → 選擇模式 → 開關控制中啟用開關控制。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 → 選択モード → スイッチ操作 でオンにします。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật Điều khiển công tắc trong Cài đặt → Chế độ chọn → Điều khiển công tắc."
          }
        }
      }
    },
    "Enable switches under Settings → Selection Mode → Switch Control. Default keys 1–4 must match the ESP32 firmware.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable switches under Settings → Selection Mode → Switch Control. Default keys 1–4 must match the ESP32 firmware."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Active los interruptores en Ajustes → Modo de selección → Control por interruptor. Las teclas 1–4 deben coincidir con el firmware ESP32."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez les switches dans Réglages → Mode de sélection → Contrôle par switch. Les touches 1–4 doivent correspondre au micrologiciel ESP32."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalter unter Einstellungen → Auswahlmodus → Schaltersteuerung aktivieren. Standardtasten 1–4 müssen zur ESP32-Firmware passen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل المفاتيح من الإعدادات ← وضع التحديد ← التحكم بالمفاتيح. المفاتيح الافتراضية 1–4 يجب أن تطابق برنامج ESP32."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置 → 选择模式 → 开关控制中启用开关。默认按键 1–4 必须与 ESP32 固件一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在設定 → 選擇模式 → 開關控制中啟用開關。預設按鍵 1–4 必須與 ESP32 韌體一致。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 → 選択モード → スイッチ操作 でオン。デフォルトキー1〜4はESP32ファームウェアと合わせてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật công tắc trong Cài đặt → Chế độ chọn → Điều khiển công tắc. Phím mặc định 1–4 phải khớp firmware ESP32."
          }
        }
      }
    },
    "Ensure you have good, even lighting. Avoid backlighting (bright light behind you) as it makes your face harder to detect.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensure you have good, even lighting. Avoid backlighting (bright light behind you) as it makes your face harder to detect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Use iluminación buena y uniforme. Evite contraluz (luz fuerte detrás), que dificulta detectar el rostro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éclairage bon et uniforme. Évitez le contre-jour (lumière vive derrière vous)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gutes, gleichmäßiges Licht. Gegenlicht vermeiden (helles Licht hinter Ihnen)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وفّر إضاءة جيدة ومتساوية. تجنب الإضاءة الخلفية (ضوء ساطع خلفك) فهي تصعّب اكتشاف الوجه."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持均匀充足的光线。避免逆光（身后强光），否则更难检测到面部。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持均勻充足的光線。避免逆光（身後強光），否則更難偵測到臉部。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明るく均一な光を。逆光（後ろが明るい）は顔を見つけにくくします。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ánh sáng đều và đủ. Tránh ngược sáng (sáng phía sau) vì khó nhận mặt."
          }
        }
      }
    },
