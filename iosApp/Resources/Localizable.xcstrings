    "This file is larger than 24.75 MB. School email may reject it. Use AirDrop or Files if sending it onward.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file is larger than 24.75 MB. School email may reject it. Use AirDrop or Files if sending it onward."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo supera 24,75 MB. El correo escolar puede rechazarlo. Use AirDrop o Archivos para enviarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier dépasse 24,75 Mo. L’e-mail scolaire peut le refuser. Utilisez AirDrop ou Fichiers pour l’envoyer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist größer als 24,75 MB. Schul-E-Mail kann sie ablehnen. Senden Sie per AirDrop oder Dateien weiter."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الملف أكبر من 24.75 ميغابايت. قد يرفضه البريد المدرسي. استخدم AirDrop أو الملفات لإرساله."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件大于 24.75 MB。学校邮箱可能会拒收。转发请用隔空投送或“文件”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案大於 24.75 MB。學校郵件可能拒收。轉寄請用 AirDrop 或「檔案」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは24.75MB超です。学校メールは拒否することがあります。転送はAirDropかファイルを使ってください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp này lớn hơn 24,75 MB. Email trường có thể từ chối. Dùng AirDrop hoặc Tệp nếu gửi tiếp."
          }
        }
      }
    },
    "This is your last chance to cancel. All custom data will be lost forever.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is your last chance to cancel. All custom data will be lost forever."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es su última oportunidad de cancelar. Todos los datos personalizados se perderán para siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernière chance d’annuler. Toutes les données personnalisées seront perdues."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzte Chance zum Abbrechen. Alle eigenen Daten gehen unwiderruflich verloren."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه فرصتك الأخيرة للإلغاء. ستضيع كل البيانات المخصصة إلى الأبد."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是取消的最后机会。所有自定义数据将永久丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
