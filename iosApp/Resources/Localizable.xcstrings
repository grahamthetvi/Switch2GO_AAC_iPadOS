    "Try tapping the Recenter Cursor button at the top of Settings if the cursor seems offset.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try tapping the Recenter Cursor button at the top of Settings if the cursor seems offset."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el cursor está desplazado, pulse Recentrar cursor arriba en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le curseur est décalé, touchez Recentrer le curseur en haut des Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der Zeiger versetzt wirkt, oben in Einstellungen auf Zeiger zentrieren tippen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن بدا المؤشر مزاحًا جرّب «إعادة توسيط المؤشر» أعلى الإعدادات."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若光标偏移，请点设置顶部的“重新居中光标”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若游標偏移，請點設定頂部的「重新置中游標」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーソルがずれて見えるときは、設定の上の「カーソルを中央に」を試してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu con trỏ lệch, chạm Căn lại con trỏ ở đầu Cài đặt."
          }
        }
      }
    },
