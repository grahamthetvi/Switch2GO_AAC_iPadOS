        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ xóa vĩnh viễn '%@'."
          }
        }
      }
    },
    "This will permanently replace your current board. Continue?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will permanently replace your current board. Continue?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto reemplazará de forma permanente su tablero actual. ¿Continuar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela remplacera définitivement votre tableau actuel. Continuer ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird Ihr aktuelles Board dauerhaft ersetzt. Fortfahren?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيستبدل هذا لوحك الحالي نهائيًا. هل تريد المتابعة؟"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久替换当前看板。继续？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將永久取代目前看板。繼續？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今のボードを完全に置き換えます。続けますか？"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ thay vĩnh viễn bảng hiện tại. Tiếp tục?"
          }
        }
      }
    },
