    "Touch, eye gaze, and head tracking still work when switches are enabled.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch, eye gaze, and head tracking still work when switches are enabled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El toque, la mirada y el seguimiento de cabeza siguen funcionando con los interruptores activados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le toucher, le regard et le suivi de la tête fonctionnent encore lorsque les switches sont activés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch, Blick und Kopfsteuerung funktionieren weiterhin, wenn Schalter aktiviert sind."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اللمس ونظرة العين وتتبع الرأس تظل تعمل عند تفعيل المفاتيح."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用开关后，触摸、眼动和头部追踪仍然可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用開關後，觸控、眼球與頭部追蹤仍然可用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スイッチをオンにしても、タッチ、視線、頭の追跡は使えます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm, nhìn và theo dõi đầu vẫn dùng được khi bật công tắc."
          }
        }
      }
    },
    "Tracking Diagnostics": {
