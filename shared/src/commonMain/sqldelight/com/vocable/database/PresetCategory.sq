-- PresetCategory table for managing preset categories
CREATE TABLE PresetCategory (
  category_id TEXT NOT NULL PRIMARY KEY,
  hidden INTEGER NOT NULL DEFAULT 0,
  sort_order INTEGER NOT NULL,
  deleted INTEGER NOT NULL DEFAULT 0,
  color_hex INTEGER,
  symbol_name TEXT
);

-- Queries
getAllPresetCategories:
SELECT * FROM PresetCategory ORDER BY sort_order ASC;

getPresetCategoryById:
SELECT * FROM PresetCategory WHERE category_id = ?;

getVisiblePresetCategories:
SELECT * FROM PresetCategory 
WHERE hidden = 0 AND deleted = 0 
ORDER BY sort_order ASC;

insertPresetCategory:
INSERT OR REPLACE INTO PresetCategory (category_id, hidden, sort_order, deleted, color_hex, symbol_name)
VALUES (?, ?, ?, ?, ?, ?);

updatePresetCategoryHidden:
UPDATE PresetCategory SET hidden = ? WHERE category_id = ?;

updatePresetCategorySortOrder:
UPDATE PresetCategory SET sort_order = ? WHERE category_id = ?;

updatePresetCategoryDeleted:
UPDATE PresetCategory SET deleted = ? WHERE category_id = ?;

updatePresetCategoryColor:
UPDATE PresetCategory SET color_hex = ? WHERE category_id = ?;

updatePresetCategorySymbol:
UPDATE PresetCategory SET symbol_name = ? WHERE category_id = ?;

getPresetCategoryCount:
SELECT COUNT(*) FROM PresetCategory WHERE deleted = 0;
