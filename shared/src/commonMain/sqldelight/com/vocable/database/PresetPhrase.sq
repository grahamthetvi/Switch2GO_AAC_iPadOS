-- PresetPhrase table for managing preset phrases
CREATE TABLE PresetPhrase (
  phrase_id TEXT NOT NULL PRIMARY KEY,
  parent_category_id TEXT NOT NULL,
  creation_date INTEGER NOT NULL,
  last_spoken_date INTEGER,
  sort_order INTEGER NOT NULL,
  deleted INTEGER NOT NULL DEFAULT 0,
  style TEXT DEFAULT NULL
);

-- Queries
getAllPresetPhrases:
SELECT * FROM PresetPhrase ORDER BY sort_order ASC;

getPresetPhraseById:
SELECT * FROM PresetPhrase WHERE phrase_id = ?;

getPresetPhrasesForCategory:
SELECT * FROM PresetPhrase 
WHERE parent_category_id = ? AND deleted = 0
ORDER BY sort_order ASC;

insertPresetPhrase:
INSERT OR REPLACE INTO PresetPhrase (phrase_id, parent_category_id, creation_date, last_spoken_date, sort_order, deleted, style)
VALUES (?, ?, ?, ?, ?, ?, ?);

updatePresetPhraseLastSpoken:
UPDATE PresetPhrase SET last_spoken_date = ? WHERE phrase_id = ?;

updatePresetPhraseStyle:
UPDATE PresetPhrase SET style = ? WHERE phrase_id = ?;

updatePresetPhraseDeleted:
UPDATE PresetPhrase SET deleted = ? WHERE phrase_id = ?;

getPresetPhraseCount:
SELECT COUNT(*) FROM PresetPhrase WHERE deleted = 0;

getPresetPhrasesCountForCategory:
SELECT COUNT(*) FROM PresetPhrase 
WHERE parent_category_id = ? AND deleted = 0;
